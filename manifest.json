{
  "manifest_version": 3,
  "name": "Auto Reject Cookies",
  "version": "1.0.0",
  "description": "Automatically clicks 'Reject all' (or switches every optional category off) on cookie banners.",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "auto-reject-cookies@example.com",
      "strict_min_version": "109.0"
    }
  }
}
